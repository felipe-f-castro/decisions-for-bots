    "test": "vitest run",
    "test:watch": "vitest",
    "smoke-demo": "node scripts/smoke-demo.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write src scripts tests README.md docs CONTRIBUTING.md .github next.config.ts vitest.config.ts tsconfig.json package.json eslint.config.mjs",
    "lint": "eslint . --max-warnings=0"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "lucide-react": "1.71.0",
    "next": "16.4.6",
    "node-appwrite": "31.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.1.0"
  },
  "license": "MIT",
  "description": "A human-in-the-loop decision inbox for AI agents.",
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
