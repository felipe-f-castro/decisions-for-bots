# Leave Appwrite values blank and set DECISIONS_DEMO=1 for the temporary in-memory demo.
# DECISIONS_DEMO is ignored when NODE_ENV=production. Production fails closed without Appwrite.
DECISIONS_DEMO=
# Public project endpoint and ID (safe for the browser).
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=<PROJECT_ID>
# Server only. NEVER prefix this with NEXT_PUBLIC_.
# Used for local development and first-run setup. On Appwrite Sites, the
# ephemeral x-appwrite-key header is used instead when present.
APPWRITE_API_KEY=
# Server only. Long random secret (at least 32 characters). Required to finish /setup.
# Proves the caller can configure this deployment. Unset it after setup. Never NEXT_PUBLIC_.
SETUP_TOKEN=
# After /setup, the database hash is the only agent credential.
# AGENT_API_KEY is used in demo mode, or before a hash exists when FALLBACK=1.
# It is never accepted alongside a stored hash. Unset both to revoke the fallback.
# Replace agent_api_key_hash (SHA-256 hex) to rotate or revoke the database key.
AGENT_API_KEY=
AGENT_API_KEY_FALLBACK=
# Optional server-only answer notifications when no database webhook is stored.
# Public HTTPS only. Blank URL disables delivery. Ignored in demo mode.
DECISION_WEBHOOK_URL=
DECISION_WEBHOOK_SECRET=
