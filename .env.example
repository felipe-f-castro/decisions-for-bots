# Leave Appwrite values blank for the public, temporary in-memory demo.
# Public project endpoint and ID (safe for the browser).
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=<PROJECT_ID>
# Server only. NEVER prefix this with NEXT_PUBLIC_.
# Used for local development and first-run setup. On Appwrite Sites, the
# ephemeral x-appwrite-key header is used instead when present.
APPWRITE_API_KEY=
# Optional fallbacks while settings are empty. After /setup, keys live in the database.
# Separate long random bearer token for /api/agent/*; unset disables the agent API until setup.
AGENT_API_KEY=
# Optional server-only answer notifications. Blank URL disables delivery.
DECISION_WEBHOOK_URL=
DECISION_WEBHOOK_SECRET=
